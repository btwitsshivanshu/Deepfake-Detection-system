# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=deepfake_db

# ---------- Security / JWT ----------
SECRET_KEY=change_this_to_a_long_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- App ----------
UPLOAD_DIR=./storage/uploads
RESULT_DIR=./storage/results
MODEL_DIR=./ml/checkpoints
MAX_UPLOAD_MB=100
FRONTEND_ORIGIN=http://localhost:5173

# ---------- ML ----------
DEVICE=cuda        # or cpu
DEFAULT_MODEL=ensemble
